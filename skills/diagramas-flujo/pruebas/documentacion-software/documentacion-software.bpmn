<?xml version="1.0" encoding="UTF-8"?>
<!--
  PRUEBA — export BPMN 2.0 XML (no el .bpm propietario de Bizagi)
  Fuente: PDF "Procedimiento de Documentación de Software" (P06-TSI, V2.0-2022,
          Capital Salud EPS-S). Mismo contenido que
          pruebas/documentacion-software/documentacion-software.mmd (v6).

  RESULTADO CONOCIDO: el usuario probó una versión anterior de este archivo en
  Bizagi Modeler real y NO lo aceptó — Bizagi Modeler solo importa su formato
  nativo .bpm, no BPMN 2.0 XML estándar. Este archivo se deja actualizado (12
  tareas en vez de 14, corregido contra el diagrama real del usuario) como
  referencia/documentación, no como una ruta de export funcional confirmada.
  Ver assets/PENDIENTE.md, sección "Export nativo a Bizagi — DESCARTADO".

  Estructura: carriles (lanes) reales por responsable — a diferencia de
  Mermaid, aquí no aplica el bug de "flecha no toca el nodo" (ver
  02-reglas-de-diagramacion.md): BPMN posiciona cada elemento con coordenadas
  explícitas (bpmndi:BPMNShape/BPMNEdge), no hay auto-layout de por medio.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_DocumentacionSoftware"
                   targetNamespace="http://almera.local/bpmn/documentacion-software"
                   exporter="skill diagramas-flujo (Claude)" exporterVersion="prueba-2">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Documentación de Software — P06-TSI V2.0-2022" processRef="Process_DocumentacionSoftware" />
  </bpmn:collaboration>

  <bpmn:process id="Process_DocumentacionSoftware" name="Documentación de Software" isExecutable="false">
    <bpmn:documentation>Fuente: Procedimiento de Documentación de Software (P06-TSI, V2.0-2022, Capital Salud EPS-S). Numeración de actividades igual a la tabla original del PDF. 12 actividades, confirmadas 1:1 (sin partir) contra el diagrama real de Bizagi de este procedimiento.</bpmn:documentation>

    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Solicitante" name="Funcionario que identifica la necesidad (Solicitante)">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IngRequerimientos" name="Ingeniero de Requerimientos">
        <bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinador" name="Coordinador de Desarrollo">
        <bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IngProgramador" name="Ingeniero Programador">
        <bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_1" name="Se identifica y justifica la necesidad de un requerimiento de software">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_1" name="1. Presentar la necesidad identificada en el proceso en el que participa">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_2" name="2. Validar el planteamiento del requerimiento según la situación actual">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_3" name="3. Diligenciar el alcance del requerimiento en el formato de levantamiento">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_4" name="4. Determinar si la documentación del requerimiento cumple las especificaciones">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_5" name="5. Describir el código en el ambiente de desarrollo con comentarios breves">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_6" name="6. Realizar los diagramas y modelos de la solución para el manual técnico">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_7" name="7. Diligenciar el diccionario de datos para el manual técnico">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_8" name="8. Diseñar el plan de pruebas según el nivel de agrupación correspondiente">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_9" name="9. Diligenciar el acta de aprobación de pruebas del requerimiento">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_10" name="10. Documentar el manual técnico y el manual de usuario">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_11" name="11. Elaborar el instructivo de implementación sobre la infraestructura tecnológica">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_12" name="12. Diligenciar el formato de aceptación y entrega final del requerimiento">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="EndEvent_1" name="Requerimiento aprobado y entregado al área solicitante">
      <bpmn:incoming>Flow_13</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="Task_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="Task_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_6" targetRef="Task_7" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_7" targetRef="Task_8" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_8" targetRef="Task_9" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_9" targetRef="Task_10" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_10" targetRef="Task_11" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_11" targetRef="Task_12" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_12" targetRef="EndEvent_1" />

    <bpmn:textAnnotation id="Annotation_1">
      <bpmn:text>🔴 Paso 4 — Revisar obligatoriamente: no se define qué ocurre si la documentación NO cumple las especificaciones</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Task_4" targetRef="Annotation_1" associationDirection="None" />

    <bpmn:textAnnotation id="Annotation_2">
      <bpmn:text>🟡 Paso 8 — El rol aparece como «Ingeniero Requerimientos» en los pasos 2-3 y «Ingeniero de Requerimientos» aquí — se asume el mismo responsable</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_2" sourceRef="Task_8" targetRef="Annotation_2" associationDirection="None" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="0" y="140" width="2200" height="560" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Solicitante_di" bpmnElement="Lane_Solicitante" isHorizontal="true">
        <dc:Bounds x="30" y="140" width="2170" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IngRequerimientos_di" bpmnElement="Lane_IngRequerimientos" isHorizontal="true">
        <dc:Bounds x="30" y="280" width="2170" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Coordinador_di" bpmnElement="Lane_Coordinador" isHorizontal="true">
        <dc:Bounds x="30" y="420" width="2170" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_IngProgramador_di" bpmnElement="Lane_IngProgramador" isHorizontal="true">
        <dc:Bounds x="30" y="560" width="2170" height="140" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1">
        <dc:Bounds x="310" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2">
        <dc:Bounds x="460" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3">
        <dc:Bounds x="610" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4">
        <dc:Bounds x="760" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5">
        <dc:Bounds x="910" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_6_di" bpmnElement="Task_6">
        <dc:Bounds x="1060" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_7_di" bpmnElement="Task_7">
        <dc:Bounds x="1210" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_8_di" bpmnElement="Task_8">
        <dc:Bounds x="1360" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_9_di" bpmnElement="Task_9">
        <dc:Bounds x="1510" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_10_di" bpmnElement="Task_10">
        <dc:Bounds x="1660" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_11_di" bpmnElement="Task_11">
        <dc:Bounds x="1810" y="590" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_12_di" bpmnElement="Task_12">
        <dc:Bounds x="1960" y="450" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="2110" y="472" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Annotation_1_di" bpmnElement="Annotation_1">
        <dc:Bounds x="700" y="20" width="260" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_2_di" bpmnElement="Annotation_2">
        <dc:Bounds x="1300" y="20" width="260" height="90" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="196" y="210" />
        <di:waypoint x="310" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="410" y="210" />
        <di:waypoint x="460" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="560" y="350" />
        <di:waypoint x="610" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="710" y="350" />
        <di:waypoint x="760" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="860" y="490" />
        <di:waypoint x="910" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1010" y="630" />
        <di:waypoint x="1060" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1160" y="630" />
        <di:waypoint x="1210" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1310" y="630" />
        <di:waypoint x="1360" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1460" y="350" />
        <di:waypoint x="1510" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="1610" y="350" />
        <di:waypoint x="1660" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1760" y="350" />
        <di:waypoint x="1810" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="1910" y="630" />
        <di:waypoint x="1960" y="490" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="2060" y="490" />
        <di:waypoint x="2110" y="490" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Association_1_di" bpmnElement="Association_1">
        <di:waypoint x="810" y="450" />
        <di:waypoint x="830" y="110" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_2_di" bpmnElement="Association_2">
        <di:waypoint x="1410" y="310" />
        <di:waypoint x="1430" y="110" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
