# Copia este archivo como .env y completa tu llave. El .env NUNCA se sube a Git.

# Llave de https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Modelo de OpenRouter (cualquier id de https://openrouter.ai/models)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# true = solo enruta a proveedores que no guardan ni entrenan con los prompts
OPENROUTER_DENY_DATA_COLLECTION=true

# 127.0.0.1 = solo este equipo. Usa 0.0.0.0 para exponerlo en la red local.
HOST=127.0.0.1
PORT=8800

# Límite de caracteres de documentación inyectada por pregunta (~4 caracteres por token)
MAX_CONTEXT_CHARS=120000

# ETL: carpeta donde Calidad deja documentos (Word, PDF, PowerPoint, Excel, .txt).
# Relativa a rag/ para pruebas, o la ruta de red en producción, sin comillas:
#   KNOWLEDGE_DIR=\\servidor\Calidad\SABIA
# Vacío = desactivado.
KNOWLEDGE_DIR=carpeta-compartida
# Cada cuántos segundos se revisa la carpeta
ETL_INTERVAL_SECONDS=300
